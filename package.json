{
  "name": "companion-satellite-mock",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=26.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:clean": "tsc --build --clean",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "yarn workspace @satellite-mock/server dev",
    "dev:ui": "yarn workspace @satellite-mock/webui dev",
    "check": "yarn format:check && yarn lint && yarn typecheck && yarn test",
    "smoke": "node scripts/smoke.mjs",
    "test:e2e": "yarn build && yarn workspace @satellite-mock/webui build && yarn workspace @satellite-mock/e2e test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
