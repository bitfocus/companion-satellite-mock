{
  "$comment": "Hand-authored conformance corpus for the Satellite API line format. See README.md.",
  "apiVersion": "1.14.0",
  "parse": [
    {
      "name": "simple pairs",
      "line": "DEVICEID=00000 KEY=0 PRESSED=true",
      "expected": { "DEVICEID": "00000", "KEY": "0", "PRESSED": "true" }
    },
    {
      "name": "quoted value with spaces",
      "line": "PRODUCT_NAME=\"Satellite Streamdeck\" KEYS_TOTAL=32",
      "expected": { "PRODUCT_NAME": "Satellite Streamdeck", "KEYS_TOTAL": "32" }
    },
    { "name": "empty line", "line": "", "expected": {} },
    { "name": "only spaces", "line": "   ", "expected": {} },
    {
      "name": "runs of spaces are collapsed",
      "quirk": null,
      "line": "  A=1   B=2  ",
      "expected": { "A": "1", "B": "2" }
    },
    { "name": "empty key is dropped", "line": "=value A=1", "expected": { "A": "1" } },
    { "name": "empty value is kept", "line": "A= B=2", "expected": { "A": "", "B": "2" } },
    { "name": "repeated key takes the last", "line": "KEY=1 KEY=2", "expected": { "KEY": "2" } },

    { "name": "splits on the first = only", "quirk": 3, "line": "VALUE=YWJjZA==", "expected": { "VALUE": "YWJjZA==" } },
    {
      "name": "data url survives intact",
      "quirk": 3,
      "line": "BITMAP=data:image/png;base64,iVBORw0KGgo=",
      "expected": { "BITMAP": "data:image/png;base64,iVBORw0KGgo=" }
    },
    { "name": "value containing an = mid-string", "quirk": 3, "line": "A=b=c=d", "expected": { "A": "b=c=d" } },

    { "name": "quotes stripped mid-fragment", "quirk": 4, "line": "KEY=\"1\"2", "expected": { "KEY": "12" } },
    {
      "name": "quotes toggle, spaces inside are literal",
      "quirk": 4,
      "line": "KEY=a\"b c\"d",
      "expected": { "KEY": "ab cd" }
    },
    {
      "name": "unterminated quote takes the remainder",
      "quirk": 4,
      "line": "TEXT=\"abc def",
      "expected": { "TEXT": "abc def" }
    },
    { "name": "quoted key", "quirk": 4, "line": "\"A\"=1", "expected": { "A": "1" } },

    { "name": "backslash escapes a quote", "quirk": 5, "line": "TEXT=\"a\\\"b\"", "expected": { "TEXT": "a\"b" } },
    { "name": "backslash escapes a space", "quirk": 5, "line": "TEXT=a\\ b", "expected": { "TEXT": "a b" } },
    { "name": "backslash escapes a backslash", "quirk": 5, "line": "TEXT=a\\\\b", "expected": { "TEXT": "a\\b" } },
    { "name": "trailing backslash consumes nothing", "quirk": 5, "line": "TEXT=a\\", "expected": { "TEXT": "a" } },

    { "name": "bare fragment becomes true", "quirk": 6, "line": "SOMEFLAG", "expected": { "SOMEFLAG": true } },
    { "name": "bare fragment alongside a pair", "quirk": 6, "line": "A B=1", "expected": { "A": true, "B": "1" } },

    { "name": "drops __proto__", "quirk": 18, "line": "__proto__=x SAFE=1", "expected": { "SAFE": "1" } },
    { "name": "drops constructor", "quirk": 18, "line": "constructor=x SAFE=1", "expected": { "SAFE": "1" } },
    { "name": "drops prototype", "quirk": 18, "line": "prototype=x SAFE=1", "expected": { "SAFE": "1" } },
    { "name": "drops __defineGetter__", "quirk": 18, "line": "__defineGetter__=x SAFE=1", "expected": { "SAFE": "1" } },
    { "name": "drops __defineSetter__", "quirk": 18, "line": "__defineSetter__=x SAFE=1", "expected": { "SAFE": "1" } },
    { "name": "drops __lookupGetter__", "quirk": 18, "line": "__lookupGetter__=x SAFE=1", "expected": { "SAFE": "1" } },
    { "name": "drops __lookupSetter__", "quirk": 18, "line": "__lookupSetter__=x SAFE=1", "expected": { "SAFE": "1" } },
    {
      "name": "banned names are fine as values",
      "quirk": 18,
      "line": "TEXT=__proto__",
      "expected": { "TEXT": "__proto__" }
    },

    {
      "name": "realistic KEY-STATE body",
      "line": "DEVICEID=\"streamdeck:12345\" KEY=4 LOCATION=\"3/1/0\" PRESSED=1 TYPE=\"BUTTON\" COLOR=\"#00ff00\" TEXT=\"Q0FNIDE=\"",
      "expected": {
        "DEVICEID": "streamdeck:12345",
        "KEY": "4",
        "LOCATION": "3/1/0",
        "PRESSED": "1",
        "TYPE": "BUTTON",
        "COLOR": "#00ff00",
        "TEXT": "Q0FNIDE="
      }
    },
    {
      "name": "realistic ADD-DEVICE body",
      "line": "DEVICEID=streamdeck:12345 PRODUCT_NAME=\"Stream Deck XL\" KEYS_TOTAL=32 KEYS_PER_ROW=8 BITMAPS=96 COLORS=hex TEXT=1 BITMAP_FORMAT=png",
      "expected": {
        "DEVICEID": "streamdeck:12345",
        "PRODUCT_NAME": "Stream Deck XL",
        "KEYS_TOTAL": "32",
        "KEYS_PER_ROW": "8",
        "BITMAPS": "96",
        "COLORS": "hex",
        "TEXT": "1",
        "BITMAP_FORMAT": "png"
      }
    },
    {
      "name": "trailing space from a Companion-emitted line",
      "quirk": 1,
      "line": "DEVICEID=\"dev1\" KEY=0 ",
      "expected": { "DEVICEID": "dev1", "KEY": "0" }
    }
  ],
  "serialise": [
    {
      "name": "trailing space before the newline",
      "quirk": 1,
      "message": "KEY-STATE",
      "status": null,
      "deviceId": "dev1",
      "args": { "KEY": 0 },
      "expected": "KEY-STATE DEVICEID=\"dev1\" KEY=0 \n"
    },
    {
      "name": "booleans as 1/0",
      "quirk": 7,
      "message": "X",
      "status": null,
      "deviceId": null,
      "args": { "A": true, "B": false },
      "expected": "X A=1 B=0 \n"
    },
    {
      "name": "numbers bare, strings quoted",
      "message": "X",
      "status": null,
      "deviceId": null,
      "args": { "N": 42, "S": "hi" },
      "expected": "X N=42 S=\"hi\" \n"
    },
    {
      "name": "no args",
      "message": "KEYS-CLEAR",
      "status": null,
      "deviceId": "dev1",
      "args": {},
      "expected": "KEYS-CLEAR DEVICEID=\"dev1\" \n"
    },
    {
      "name": "OK response",
      "message": "ADD-DEVICE",
      "status": "OK",
      "deviceId": "dev1",
      "args": {},
      "expected": "ADD-DEVICE OK DEVICEID=\"dev1\" \n"
    },
    {
      "name": "OK response with an argument",
      "message": "SET-VARIABLE-VALUE",
      "status": "OK",
      "deviceId": "dev1",
      "args": { "VARIABLE": "some-id" },
      "expected": "SET-VARIABLE-VALUE OK DEVICEID=\"dev1\" VARIABLE=\"some-id\" \n"
    },
    {
      "name": "error response",
      "message": "KEY-PRESS",
      "status": "ERROR",
      "deviceId": "dev1",
      "args": { "MESSAGE": "Device not found" },
      "expected": "KEY-PRESS ERROR DEVICEID=\"dev1\" MESSAGE=\"Device not found\" \n"
    },
    {
      "name": "unknown command error has no device id",
      "message": "ERROR",
      "status": null,
      "deviceId": null,
      "args": { "MESSAGE": "Unknown command: NOPE" },
      "expected": "ERROR MESSAGE=\"Unknown command: NOPE\" \n"
    },
    {
      "name": "line too long doubles the ERROR token",
      "quirk": 10,
      "message": "ERROR",
      "status": "ERROR",
      "deviceId": null,
      "args": { "MESSAGE": "Line too long" },
      "expected": "ERROR ERROR MESSAGE=\"Line too long\" \n"
    },
    {
      "name": "BEGIN handshake",
      "message": "BEGIN",
      "status": null,
      "deviceId": null,
      "args": { "CompanionVersion": "5.1.0", "ApiVersion": "1.14.0" },
      "expected": "BEGIN CompanionVersion=\"5.1.0\" ApiVersion=\"1.14.0\" \n"
    },
    {
      "name": "CAPS",
      "message": "CAPS",
      "status": null,
      "deviceId": null,
      "args": { "SUBSCRIPTIONS": true, "NONSQUARE": true, "BITMAP_FORMATS": "rgb,png,webp", "ROTARY_AMOUNT": true },
      "expected": "CAPS SUBSCRIPTIONS=1 NONSQUARE=1 BITMAP_FORMATS=\"rgb,png,webp\" ROTARY_AMOUNT=1 \n"
    },
    {
      "name": "BRIGHTNESS",
      "message": "BRIGHTNESS",
      "status": null,
      "deviceId": "dev1",
      "args": { "VALUE": 100 },
      "expected": "BRIGHTNESS DEVICEID=\"dev1\" VALUE=100 \n"
    },
    {
      "name": "LOCKED-STATE with rotation",
      "message": "LOCKED-STATE",
      "status": null,
      "deviceId": "dev1",
      "args": { "LOCKED": true, "CHARACTER_COUNT": 2, "ROTATION": -90 },
      "expected": "LOCKED-STATE DEVICEID=\"dev1\" LOCKED=1 CHARACTER_COUNT=2 ROTATION=-90 \n"
    },
    {
      "name": "FONT_SIZE may be the string auto",
      "quirk": 12,
      "message": "KEY-STATE",
      "status": null,
      "deviceId": "dev1",
      "args": { "KEY": 0, "FONT_SIZE": "auto" },
      "expected": "KEY-STATE DEVICEID=\"dev1\" KEY=0 FONT_SIZE=\"auto\" \n"
    },
    {
      "name": "argument order is preserved",
      "message": "X",
      "status": null,
      "deviceId": null,
      "args": { "B": 1, "A": 2 },
      "expected": "X B=1 A=2 \n"
    }
  ]
}
