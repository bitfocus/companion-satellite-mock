# Reference reverse proxy for a public deployment. Caddy terminates TLS and is the only thing
# exposed; the mock itself never speaks TLS. See docs/design.md §9.5 and docs/security.md.
#
# Two settings in docker-compose.yml must agree with this file:
#
# - PUBLIC_ORIGIN must be exactly the scheme and host below (https://satellite-mock.companion.free,
#   no trailing slash). The web UI's socket refuses any other Origin, so a mismatch fails closed:
#   the UI will not connect.
# - TRUSTED_PROXY_HOPS must be 1. Caddy, with no `trusted_proxies` configured, discards any
#   X-Forwarded-For the client sent and sets it to the real client address, so the server can trust
#   exactly one hop. Put another proxy or a CDN in front of Caddy and both this file
#   (`trusted_proxies`) and the hop count must change together, or every per-IP limit either
#   collapses onto the CDN's address or becomes forgeable.

satellite-mock.companion.free {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Plain HTTP requests are small (the UI talks over its WebSocket); refuse anything large before
	# it reaches the app. WebSocket frames are capped by the app itself.
	request_body {
		max_size 64KB
	}

	# The satellite WebSocket endpoint. Native clients send no Origin header, so no Origin check here.
	handle /ws/satellite {
		reverse_proxy satellite-mock:16623
	}

	# For the container healthcheck, which reaches the app directly. Nothing outside needs the
	# session count it reports.
	handle /healthz {
		respond 404
	}

	# Web UI and its tRPC WebSocket, same origin.
	handle {
		reverse_proxy satellite-mock:16624
	}

	# Note there is deliberately NO route to the metrics listener (:16625). It is a separate port
	# bound inside the compose network, so the public origin has no path to it at all — there is no
	# rule here to get wrong. Scrape it from a Prometheus on the same network.
	#
	# If it must be scraped from outside, expose it explicitly and require the bearer token, rather
	# than relying on the path being unguessable:
	#
	#   handle /metrics {
	#       @authorised header Authorization "Bearer {env.METRICS_TOKEN}"
	#       handle @authorised {
	#           reverse_proxy satellite-mock:16625
	#       }
	#       respond 404
	#   }
	#
	# (404 rather than 401, so an unauthenticated prober cannot tell the endpoint exists.)
}
